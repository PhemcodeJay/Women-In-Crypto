# ═══════════════════════════════════════════════════════════════
#           Women in Crypto Alliance - .env file
# ═══════════════════════════════════════════════════════════════

# ─── Security ────────────────────────────────────────────────────
# Generate a strong one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=super-long-random-string-please-change-this-1234567890abcdef

# ─── Email Configuration ─────────────────────────────────────────
# For development you can leave these commented out → emails won't send but app still works
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=abcd-efgh-ijkl-mnop          # ← must be Gmail App Password (not normal password)
# MAIL_USE_TLS=True
# MAIL_DEFAULT_SENDER=yourname@gmail.com

# ─── Admin Account ───────────────────────────────────────────────
# Change both values before going live!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123                     # ← change this immediately!

# ─── Database & Uploads ──────────────────────────────────────────
# Option A: Keep everything inside project folder (easiest for now)
# (recommended while folder still has spaces in path)
DB_FILENAME=cryptowomen.db

# Option B: Put database & uploads in a folder without spaces
# (uncomment & adjust if you want to avoid future Windows path issues)
# DB_PATH=C:/wic-data/cryptowomen.db
# UPLOAD_PATH=C:/wic-data/uploads

# If you keep uploads inside the project folder, you can leave this or set a subfolder
UPLOAD_SUBDIR=uploads                       # ← no spaces recommended

# Option C: Very explicit full paths (use only if needed)
# DB_PATH=C:\Users\Bossman\Documents\Women-In-Crypto\cryptowomen.db
# UPLOAD_PATH=C:\Users\Bossman\Documents\Women-In-Crypto\uploads